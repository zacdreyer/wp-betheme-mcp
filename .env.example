# Single-site configuration (simplest setup)
BETHEME_MCP_API_KEY=change-me
BETHEME_MCP_BASE_URL=https://your-wordpress-site.test
BETHEME_MCP_TIMEOUT_MS=10000

# Multi-site agency configuration (overrides single-site values)
# BETHEME_MCP_SITES=[{"name":"client-a","baseUrl":"https://client-a.test","apiKey":"key-a"},{"name":"client-b","baseUrl":"https://client-b.test","apiKey":"key-b"}]
